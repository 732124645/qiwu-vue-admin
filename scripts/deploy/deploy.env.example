# Settings of scripts/deploy/server-deploy.sh, installed as deploy.env next to its bin/ directory
# (/opt/qiwu-deploy/deploy.env, root-owned, 0644).
# No secrets here: database and Redis credentials stay in <root>/shared/apps/server/.env.local.
QW_DEPLOY_ROOT=/srv/qiwu
QW_REPO=732124645/qiwu-vue-admin # public GitHub repository <owner>/<name> the tags come from
QW_APP_USER=qiwu                 # the script refuses to run as anyone else
QW_PM2_NAME=qiwu-server
QW_PM2_INSTANCES=2
QW_HEALTH_URL=http://127.0.0.1:3000/api/health
QW_HEALTH_TRIES=30 # 2 s apart
QW_KEEP_RELEASES=3
QW_MIN_FREE_MB=3072
QW_DEPLOY_SEED=1         # seeds are idempotent; new menus and permissions need them
QW_ASSET_CARRY_DAYS=14   # older hashed web assets stay this long for open tabs and CDN caches
QW_SHARED_LINKS="apps/server/.env apps/server/.env.local"
QW_DB_NAME=              # with QW_DB_BACKUP_CNF: mysqldump before migrating
QW_DB_BACKUP_CNF=        # MySQL option file (0600) of a backup-only account
QW_MIGRATE_ENV=          # optional env file with a DDL-capable DB_USER / DB_PASSWORD, for migrate + seed only
QW_ALLOW_DOWNGRADE=0
QW_BUILD_TIMEOUT=30m     # time limit of pnpm install and of the build, each (GNU timeout units)
QW_MIGRATE_TIMEOUT=10m   # time limit of migrate and of seed, each: a DDL waiting on a lock blocks that table
