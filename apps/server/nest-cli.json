{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*.json",
        "watchAssets": true
      },
      {
        "include": "../../../packages/shared/src/i18n/**/*.json",
        "outDir": "dist"
      },
      {
        "include": "../codegen-templates/**/*.ejs",
        "outDir": "dist/codegen-templates"
      }
    ]
  }
}
