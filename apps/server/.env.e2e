# Playwright e2e — committed. Layered after the git-ignored .env.local (apps/web/e2e/env.ts,
# mobile/e2e/env.ts; a parallel checkout's .env.e2e.local comes last), so a key here — even empty — beats
# .env.local: never add DB_USER / DB_PASSWORD / REDIS_USERNAME / REDIS_PASSWORD, they come from
# .env.local only. APP_SECRET / SEED_ADMIN_PASSWORD below are throwaway test fixtures for the
# local test database, not credentials; the server binds 127.0.0.1 only.
NODE_ENV=test
HOST=127.0.0.1
PORT=3200
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qiwu_e2e
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=14
REDIS_KEY_PREFIX=qw:
APP_SECRET=e2e-only-app-secret-not-for-production-0001
TRUST_PROXY=loopback
SWAGGER_ENABLED=true
LOG_LEVEL=warn
ALLOW_PRIVATE_ENDPOINTS=true
CODEGEN_WRITE=false
SEED_ADMIN_PASSWORD=Admin@12345-not-for-production
# uploads of this mode only (git-ignored data/)
STORAGE_LOCAL_ROOT=./data/e2e-upload
