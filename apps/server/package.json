  "scripts": {
    "build": "nest build",
    "db:migrate": "pnpm build && node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/db/migrate.js",
    "db:reset": "pnpm build && node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/db/reset.js",
    "db:seed": "pnpm build && node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/db/seed.js",
    "dev": "node ../../scripts/dev-server.mjs",
    "gen": "pnpm build && node --env-file-if-exists=.env.local --env-file-if-exists=.env dist/modules/platform/codegen/cli.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json --customConditions source"
  },
