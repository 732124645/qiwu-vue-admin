# Server tests (Vitest, smoke:boot, gen:check-golden) — committed. Layered after the git-ignored
# .env.local (test/setup/load-env.ts; a parallel checkout's .env.test.local comes last), so a key here —
# even empty — beats .env.local: never add DB_USER / DB_PASSWORD / REDIS_USERNAME / REDIS_PASSWORD,
# they come from .env.local only. APP_SECRET / SEED_ADMIN_PASSWORD below are throwaway test
# fixtures for the local test database, not credentials; the server binds 127.0.0.1 only.
NODE_ENV=test
HOST=127.0.0.1
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qiwu_test
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15
REDIS_KEY_PREFIX=qw:
APP_SECRET=test-only-app-secret-not-for-production-0001
TRUST_PROXY=loopback
SWAGGER_ENABLED=true
LOG_LEVEL=warn
ALLOW_PRIVATE_ENDPOINTS=true
CODEGEN_WRITE=false
SEED_ADMIN_PASSWORD=Admin@12345-not-for-production
# uploads of this mode only (git-ignored data/): specs may wipe it
STORAGE_LOCAL_ROOT=./data/test-upload
