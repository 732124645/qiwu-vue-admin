# Copy to .env (dev config) — both .env and .env.local are git-ignored.
# .env.local is NOT a local override file: a key in both files => the .env value wins. To override
# non-secret config, edit .env or set it in the process environment. (The test files work the other
# way round: .env.test.local / .env.e2e.local override .env.test / .env.e2e.) At startup the server
# warns with the names (never the values) of keys both files set to different values, and after
# listen it logs one "effective config:" line with the non-secret values it runs with.
# The server loads the mode file (ENV_FILE, default .env; tests use .env.test, Playwright .env.e2e)
# first, then .env.local; variables already in the process env win. Validated by EnvSchema
# (src/core/config/env.schema.ts): the server refuses to start with a missing/invalid value.
# A key written in .env — even empty (`KEY=`) — hides the same key in .env.local (the server takes
# the first file that defines it; the db:* scripts load .env.local then .env, the later file wins:
# same result). So the credentials below never appear in .env, only in .env.local (loaded in every
# mode: dev, test, e2e):
#   DB_USER=qiwu
#   DB_PASSWORD=...
#   REDIS_USERNAME=...        # omit when Redis has no ACL user
#   REDIS_PASSWORD=...
#   APP_SECRET=...            # required, >= 32 random chars (derives SecretBox keys), e.g. the
#                             # output of `openssl rand -base64 48`
#   SEED_ADMIN_PASSWORD=...   # optional: unset => db:seed prints a random admin password once,
#                             # to be changed at first login
#   WX_MP_APPID / WX_MP_SECRET: see WeChat below
NODE_ENV=development
PORT=3000
# bind address; keep loopback locally (the reverse proxy / Vite proxy is the only client)
HOST=127.0.0.1

# MySQL (single datasource)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qiwu_dev
# connection pool per process (every PM2 worker has its own; see docs/deploy.md): size, then the
# longest wait for a free connection before a 503 (ms; 0 = wait forever) and the most requests
# allowed to wait (0 = no limit). Production: consider DB_POOL_ACQUIRE_TIMEOUT_MS=10000
DB_POOL_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT_MS=0
DB_POOL_QUEUE_LIMIT=0

# Redis — every key is prefixed; the app never needs admin/dangerous commands
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=13
REDIS_KEY_PREFIX=qw:

# token lifetimes (APP_SECRET: .env.local, see the top)
ACCESS_TTL_SEC=1800
REFRESH_TTL_SEC=604800

# Express trust proxy: only the real reverse-proxy address (never whole private ranges)
TRUST_PROXY=loopback
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
LOG_LEVEL=info
# stall diagnostics (docs/scale-out.md), 0 = off: mark request lines at least this slow (warn, with the
# jobs then running in the process); one event-loop line per interval, at warn from this max delay (ms)
LOG_SLOW_REQUEST_MS=0
LOG_EVENT_LOOP_INTERVAL_MS=0
LOG_EVENT_LOOP_WARN_MS=0

# SSRF guard for admin-configured endpoints (S3/SMTP): keep false outside tests
ALLOW_PRIVATE_ENDPOINTS=false
# extra ports those endpoints may use (defaults: S3 80,443; SMTP 25,465,587), e.g. 9000,8333
OUTBOUND_S3_PORTS=
OUTBOUND_SMTP_PORTS=
CODEGEN_WRITE=false
APP_DEMO_MODE=false
# What this process runs (docs/scale-out.md), read at startup only: all = HTTP + cron + queue workers;
# api = HTTP only (needs at least one all/worker instance, or cron and queues stop); worker = cron +
# queue workers, still listening on its own PORT for health checks and Socket.IO pushes
APP_ROLE=all
# Multi-tenancy (docs/multi-tenancy.md): read at startup only; switching it restarts every instance
APP_MULTI_TENANT=false
# WeChat Official Account management (docs/wxoa.md): read at startup only; off => the module is not
# loaded (every /api/wxoa route 404, no jobs, no calls to WeChat) and its menus are hidden
APP_WXOA=false
# Agent access over MCP (docs/mcp.md): read at startup only; off => the module is not loaded (/api/mcp
# and every MCP admin route 404) and its menus are hidden; param mcp.paused is the running stop switch
APP_MCP=false
# 后台智能体（智能助手对话页、模型与联网工具、外部 MCP、技能；see docs/agent.md），默认关闭；改后重启生效。
# 模型与搜索服务在平台的“智能体设置”页配置（密钥加密存库），这里不放任何密钥。
APP_AGENT=false
STORAGE_LOCAL_ROOT=./data/upload
# WeChat mini program sign-in (also param auth.wx_mp.enabled; either unset => the wx-mp routes
# answer 404), in .env.local only (see the top):
#   WX_MP_APPID=wx...
#   WX_MP_SECRET=...          # the AppSecret: never in a committed file
