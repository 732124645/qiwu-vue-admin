# Copy to .env (dev config) — both .env and .env.local are git-ignored.
# The server loads the mode file (ENV_FILE, default .env; tests use .env.test, Playwright .env.e2e)
# first, then .env.local; variables already in the process env win. Validated by EnvSchema
# (src/core/config/env.schema.ts): the server refuses to start with a missing/invalid value.
# A key written in .env — even empty (`KEY=`) — hides the same key in .env.local (the server takes
# the first file that defines it; the db:* scripts load .env.local then .env, the later file wins:
# same result). So the credentials below never appear in .env, only in .env.local (loaded in every
# mode: dev, test, e2e):
#   DB_USER=qiwu
#   DB_PASSWORD=...
#   REDIS_USERNAME=...        # omit when Redis has no ACL user
#   REDIS_PASSWORD=...
#   APP_SECRET=...            # required, >= 32 random chars (derives SecretBox keys), e.g. the
#                             # output of `openssl rand -base64 48`
#   SEED_ADMIN_PASSWORD=...   # optional: unset => db:seed prints a random admin password once,
#                             # to be changed at first login
#   WX_MP_APPID / WX_MP_SECRET: see WeChat below
NODE_ENV=development
PORT=3000
# bind address; keep loopback locally (the reverse proxy / Vite proxy is the only client)
HOST=127.0.0.1

# MySQL (single datasource)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qiwu_dev

# Redis — every key is prefixed; the app never needs admin/dangerous commands
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=13
REDIS_KEY_PREFIX=qw:

# token lifetimes (APP_SECRET: .env.local, see the top)
ACCESS_TTL_SEC=1800
REFRESH_TTL_SEC=604800

# Express trust proxy: only the real reverse-proxy address (never whole private ranges)
TRUST_PROXY=loopback
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
LOG_LEVEL=info

# SSRF guard for admin-configured endpoints (S3/SMTP): keep false outside tests
ALLOW_PRIVATE_ENDPOINTS=false
# extra ports those endpoints may use (defaults: S3 80,443; SMTP 25,465,587), e.g. 9000,8333
OUTBOUND_S3_PORTS=
OUTBOUND_SMTP_PORTS=
CODEGEN_WRITE=false
APP_DEMO_MODE=false
STORAGE_LOCAL_ROOT=./data/upload
# WeChat mini program sign-in (also param auth.wx_mp.enabled; either unset => the wx-mp routes
# answer 404), in .env.local only (see the top):
#   WX_MP_APPID=wx...
#   WX_MP_SECRET=...          # the AppSecret: never in a committed file
