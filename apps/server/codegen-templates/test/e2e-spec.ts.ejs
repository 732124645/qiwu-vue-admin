/** A binary (xlsx) response body as a Buffer. */
const binary = (r: request.Response, cb: (err: Error | null, body: Buffer) => void) => {
  const chunks: Buffer[] = []
  r.on('data', (c: Buffer) => chunks.push(c))
  r.on('end', () => cb(null, Buffer.concat(chunks)))
}
/** The first sheet of an xlsx body (or none). */
async function sheet(body: unknown) {
  const wb = new ExcelJS.Workbook()
  await wb.xlsx.load(body as Parameters<typeof wb.xlsx.load>[0])
  return wb.worksheets[0]
}
const cells = (ws: ExcelJS.Worksheet, row: number, length: number) =>
  Array.from({ length }, (_, i) => ws.getRow(row).getCell(i + 1).value ?? null)
