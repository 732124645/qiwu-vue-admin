<%_ if (m.withImport) { _%>

describe('import', () => {
  /** An .xlsx with the import headers (zh-CN labels) and `rows` (cells by field). */
  async function xlsx(rows: Record<string, unknown>[]) {
    const wb = new ExcelJS.Workbook()
    const ws = wb.addWorksheet('import')
    ws.addRow(IMPORT.map(([, key]) => t('zh-CN', key)))
    for (const r of rows) ws.addRow(IMPORT.map(([field]) => r[field] ?? null))
    return Buffer.from(await wb.xlsx.writeBuffer())
  }
  const upload = (who: keyof typeof tokens, file: Buffer, mode = 'insert', traceId = unique()) =>
    request(app.getHttpServer())
      .post(`${URL}/import`)
      .set(bearer(tokens[who]))
      .set('X-Request-Id', traceId)
      .field('mode', mode)
      .attach('file', file, 'import.xlsx')
  /** The newest row of the list. */
  const newest = async () =>
    (await call('admin', 'get').query({ sort: '-id', pageSize: 1 }).expect(200)).body.data.items

  it('import template: the importable columns as translated headers', async () => {
    const res = await call('admin', 'get', '/import-template').buffer(true).parse(binary).expect(200)
    expect(res.headers['content-disposition']).toBe('attachment; filename="<%= m.bizs %>.xlsx"')
    expect(cells((await sheet(res.body))!, 1, IMPORT.length)).toEqual(IMPORT.map(([, key]) => t('zh-CN', key)))
  })

  it('import: valid rows are inserted<% if (bad) { %>, failed ones reported<% } %><% if (m.importKey) { %>; upsert updates by <%= m.importKey.field %><% } else { %>; no upsert (no unique column to match by)<% } %>', async () => {
    const tag = unique()
<%_ if (bad) { _%>
    const res = await upload('admin', await xlsx([body(`${tag}-a`), body(`${tag}-b`, { <%= bad.field %>: '' })])).expect(200)
    expect(res.body.data).toMatchObject({ inserted: 1, updated: 0, failed: 1, reportId: expect.any(String) })
<%_ } else { _%>
    const res = await upload('admin', await xlsx([body(`${tag}-a`)])).expect(200)
    expect(res.body.data).toMatchObject({ inserted: 1, updated: 0, failed: 0 })
<%_ } _%>
    expect(await newest()).toMatchObject([body(`${tag}-a`)])
<%_ if (m.importKey && change) { _%>
    const again = { ...body(`${tag}-a`), <%= change.field %>: `${tag} imported` }
    const up = await upload('admin', await xlsx([again]), 'upsert').expect(200)
    expect(up.body.data).toMatchObject({ inserted: 0, updated: 1, failed: 0 })
    expect(await newest()).toMatchObject([again])
<%_ } else if (!m.importKey) { _%>
    const before = await count()
    await upload('admin', await xlsx([body(`${tag}-a`)]), 'upsert').expect(400)
    expect(await count()).toBe(before)
<%_ } _%>
  })

<%_ if (scope && m.importKey) { _%>
  it('import upsert matches only rows in the data scope: a <%= m.importKey.field %> of another dept fails, nothing overwritten', async () => {
    const tag = unique()
    const other = await addIn(DEPT.other, tag)
    const res = await upload('own', await xlsx([body(tag, { <%= deptField %>: DEPT.mine })]), 'upsert').expect(200)
    expect(res.body.data).toMatchObject({ inserted: 0, updated: 0, failed: 1 })
    expect((await call('admin', 'get', `/${other.id}`).expect(200)).body.data).toEqual(other)
  })

<%_ } _%>
  it('import: 403 without <%= m.key %>.import, action-logged', async () => {
    const file = await xlsx([body(unique())])
    await upload('reader', file).expect(403)
    const traceId = `${PREFIX}${process.pid}-import`
    await upload('admin', file, 'insert', traceId).expect(200)
    expect(await logOf(ds, traceId)).toMatchObject({ domain: '<%= m.key %>', verb: 'import', ok: 1 })
  })
})
<%_ } _%>

