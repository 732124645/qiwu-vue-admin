<%_
const b = m.biz
const T = m.table
const P = m.parent.field
const toggle = !!m.enabled
const sorted = !!m.sortNo && m.sortNo.inForm
const text = (c) => c.tsType === 'string' && c.base !== 'date' && c.base !== 'decimal' && !c.dict
// rows are found by their ids; a text column searched by `like` (crud.ts `specKey`) also keys the tags
// and gets the filter case
const key = m.specKey
// tags are PREFIX + a number + up to 4 more characters: the prefix is cut to fit the key column
const PREFIX = `e2e-${m.business}-`.slice(0, (key ? key.length ?? 64 : 64) - 6)
// a text column shorter than a tag gets the tag's end
const TAG_MAX = PREFIX.length + 8
// test data: required, unique (distinct per tag) and example fields; the parent is set per row
const inBody = m.form.filter((c) => c !== m.parent && !c.secret && (c === key || c.required || c.example || c.unique))
const rest = m.form.filter((c) => c !== m.parent && !c.secret && !inBody.includes(c) && (c.dflt || c.nullable))
// a unique number: counted down from its maximum, one per tag
const counted = inBody.filter((c) => c.unique && !c.example && c.tsType === 'number')
// the field the 400 case empties or leaves out: the key, else a required one
const bad = key ?? m.form.find((c) => c.required && !c.secret)
const secrets = m.secrets
const Node = m.Biz + 'Node'
