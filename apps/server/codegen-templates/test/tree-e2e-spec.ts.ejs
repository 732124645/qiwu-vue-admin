const PREFIX = '<%= PREFIX %>'
const URL = '/api/<%= m.url %>'
const MISSING = 999_999
/** the form's fields, as the edit form sends them back */
const FORM = [<% m.form.filter((c) => !c.secret).forEach((c, i) => { %><% if (i) { %>, <% } %>'<%= c.field %>'<% }) %>]

let app: NestExpressApplication
let ds: DataSource
let redis: Redis
let i18n: I18nService
const tokens: Record<'admin' | 'reader' | 'plain', string> = { admin: '', reader: '', plain: '' }
const userIds: number[] = []
let roleId: number
/** the table's last id before this spec: every row above it is this spec's (cleanup) */
let lastId = 0

const call = (
  who: keyof typeof tokens,
  method: 'get' | 'post' | 'put' | 'delete',
  path = '',
  body?: object,
) => {
  const req = request(app.getHttpServer())[method](`${URL}${path}`).set(bearer(tokens[who]))
  return body ? req.send(body) : req
}
const create = (body: object) => call('admin', 'post', '', body)
let seq = 0
const unique = () => `${PREFIX}${++seq}`
<%_ if (counted.length) { _%>
const numbers = new Map<string, number>()
/** A number of its own for `tag` (1, 2, … in the order tags are first seen). */
const numberOf = (tag: string) => {
  if (!numbers.has(tag)) numbers.set(tag, numbers.size + 1)
  return numbers.get(tag)!
}
<%_ } _%>
/** A valid POST body made of `tag` (required and unique fields, the configured examples), top level. */
const body = (tag: string, over: object = {}) => ({
<%_ for (const c of inBody) { _%>
  <%_ if (c === key) { _%>
  <%= c.field %>: tag,
  <%_ } else if (c.example) { _%>
  <%= c.field %>: <%= c.example %>,
  <%_ } else if (c.base === 'decimal' && c.tsType === 'string') { _%>
  <%= c.field %>: '<%= c.scale ? '1.' + '0'.repeat(c.scale) : '1' %>',
  <%_ } else if (text(c) && (c.length ?? 64) < TAG_MAX) { _%>
  <%= c.field %>: tag.slice(-<%= c.length %>),
  <%_ } else if (text(c) && (c.length ?? 0) < 32) { _%>
  <%= c.field %>: tag,
  <%_ } else if (text(c)) { _%>
  <%= c.field %>: `${tag} <%= c.field %>`,
  <%_ } else if (c.base === 'boolean') { _%>
  <%= c.field %>: true,
  <%_ } else if (counted.includes(c)) { _%>
  <%= c.field %>: <%= c.web.max ?? '999_999_999' %> - numberOf(tag),
  <%_ } else if (c.tsType === 'number') { _%>
  <%= c.field %>: 1,
  <%_ } else if (c.base === 'date') { _%>
  <%= c.field %>: '2024-01-01',
  <%_ } else if (c.tsType === 'Date') { _%>
  <%= c.field %>: '2024-01-01T08:00:00.000Z',
  <%_ } else { _%>
  <%= c.field %>: tag,
  <%_ } _%>
<%_ } _%>
  ...over,
})
/** A row added through the API under `parent` (0 = top level), as POST answers it. */
const add = async (parent: number, over: object = {}, tag = unique()) =>
  (await create(body(tag, { <%= P %>: parent, ...over })).expect(201)).body.data
/** The forest GET / answers for `query`. */
const list = async (query: object = {}): Promise<<%= Node %>[]> =>
  (await call('admin', 'get').query(query).expect(200)).body.data
/** The node `id` anywhere in `nodes`. */
const find = (nodes: <%= Node %>[], id: number): <%= Node %> | undefined => {
  for (const n of nodes) {
    const hit = n.id === id ? n : find(n.children, id)
    if (hit) return hit
  }
}
/** Id tree of nodes: `id` or `[id, children]`. */
type Shape = number | [number, Shape[]]
const shape = (nodes: <%= Node %>[]): Shape[] =>
  nodes.map((n) => (n.children.length ? [n.id, shape(n.children)] : n.id))
const pathOf = async (id: number): Promise<string> =>
  (await ds.query('SELECT tree_path AS p FROM <%= T %> WHERE id = ?', [id]))[0].p
/** Synthetic ASCII ancestor ids, ending in the real id, for exact column-length fixtures. */
const setPathLength = async (id: number, length: number): Promise<string> => {
  const prefix = `/${MISSING}/`
  const padding = length - prefix.length - `${id}/`.length
  const odd = padding % 2
  const path = `${prefix}${'1/'.repeat((padding - odd * 3) / 2)}${odd ? '11/' : ''}${id}/`
  expect(path).toHaveLength(length)
  await ds.query('UPDATE <%= T %> SET tree_path = ? WHERE id = ?', [path, id])
  return path
}
/** A translated message (the app's own translations). */
const t = (lang: string, key: string, args?: object) => i18n.t(key, { lang, args }) as string
const label = (lang: string, field: string) => t(lang, `field.<%= m.key %>.${field}`)
const expectErr = (res: request.Response, status: number, code: string) => {
  expect(res.status).toBe(status)
  expect(res.body.code).toBe(code)
}

async function user(name: string, roles: number[]) {
  const id = await insertRow(ds.manager, 'iam_user', {
    username: PREFIX + name,
    display_name: name,
    password_hash: 'not-used-by-this-spec',
    password_changed_at: new Date(),
  })
  for (const r of roles)
    await ds.query('INSERT INTO iam_user_roles (user_id, role_id) VALUES (?, ?)', [id, r])
  userIds.push(id)
  return (await signIn(app, PREFIX + name)).accessToken
}

beforeAll(async () => {
  const moduleRef = await Test.createTestingModule({ imports: [AppModule] }).compile()
  app = setupApp(moduleRef.createNestApplication<NestExpressApplication>({ logger: false }))
  await app.listen(0, '127.0.0.1')
  ds = app.get<DataSource>(getDataSourceToken())
  redis = app.get(REDIS)
  i18n = app.get(I18nService)
  await cleanRedis(redis)
  lastId = Number((await ds.query('SELECT COALESCE(MAX(id), 0) AS n FROM <%= T %>'))[0].n)
  roleId = await insertRow(ds.manager, 'iam_role', {
    code: `${PREFIX}reader`,
    name: `${PREFIX}reader`,
    data_scope: 'all',
  })
  const browse = await findId(ds.manager, 'iam_menu', { perms: <%= b %>Perms.browse })
  await ds.query('INSERT INTO iam_role_menus (role_id, menu_id) VALUES (?, ?)', [roleId, browse])
  tokens.admin = (await signIn(app)).accessToken
  tokens.reader = await user('reader', [roleId])
  tokens.plain = await user('plain', [])
})

afterAll(async () => {
  if (ds) {
    await ds.query('DELETE FROM <%= T %> WHERE id > ?', [lastId])
    if (userIds.length) {
      await ds.query('DELETE FROM iam_user_roles WHERE user_id IN (?)', [userIds])
      await ds.query('DELETE FROM iam_user WHERE id IN (?)', [userIds])
    }
    await ds.query('DELETE FROM iam_role_menus WHERE role_id = ?', [roleId])
    await ds.query('DELETE FROM iam_role WHERE id = ?', [roleId])
  }
  if (redis) await cleanRedis(redis)
  await app?.close()
})

describe('tree', () => {
  it.each([false, true])(
    'path length: create and a move overflowing only a descendant (deleted=%s) return 422 without writes',
    async (deleted) => {
      const a = await add(0)
      const b = await add(a.id)
      const x = await add(0)
      if (deleted) await call('admin', 'delete', `/${b.id}`).expect(200)
      await setPathLength(x.id, 512)
      const tag = unique()
      const created = await create(body(tag, { <%= P %>: x.id })).set('Accept-Language', 'en-US')
      expectErr(created, 422, Err.TREE_PATH_TOO_LONG.code)
      expect(created.body.msg).toBe(t('en-US', Err.TREE_PATH_TOO_LONG.key))
      expect(await ds.query('SELECT id FROM <%= T %> WHERE <%= m.parent.column %> = ?', [x.id])).toEqual([])
      await ds.query('UPDATE <%= T %> SET updated_by = NULL WHERE id IN (?)', [[a.id, b.id]])
      const rows = () =>
        ds.query(
          'SELECT <%= m.parent.column %>, tree_path, updated_by, updated_at, deleted_at FROM <%= T %> WHERE id IN (?) ORDER BY id',
          [[a.id, b.id]],
        )
      const before = await rows()
      const suffix = `${a.id}/${b.id}/`
      const tooDeep = await setPathLength(x.id, 513 - suffix.length)
      expect(`${tooDeep}${a.id}/`.length).toBeLessThan(512)
      const moved = await call('admin', 'put', `/${a.id}`, { <%= P %>: x.id })
      expectErr(moved, 422, Err.TREE_PATH_TOO_LONG.code)
      expect(moved.body.msg).toBe(t('zh-CN', Err.TREE_PATH_TOO_LONG.key))
      expect(await rows()).toEqual(before)
      const boundary = await setPathLength(x.id, 512 - suffix.length)
      await call('admin', 'put', `/${a.id}`, { <%= P %>: x.id }).expect(200)
      expect(await pathOf(a.id)).toBe(`${boundary}${a.id}/`)
      expect(await pathOf(b.id)).toBe(`${boundary}${suffix}`)
      expect(await pathOf(b.id)).toHaveLength(512)
      expect((await rows())[1].deleted_at !== null).toBe(deleted)
    },
  )

<%_ if (secrets.length) { _%>
  it('secrets are boxed on create and replace, hidden on every read, and kept when omitted', async () => {
    const first = { <% for (const c of secrets) { %><%= c.secret.body %>: 'first-<%= c.secret.body %>', <% } %> }
    const next = { <% for (const c of secrets) { %><%= c.secret.body %>: 'next-<%= c.secret.body %>', <% } %> }
    const posted = (await create(body(unique(), first)).expect(201)).body.data
    const id = posted.id as number
    const box = app.get(SecretBox)
    const stored = async () => (await ds.query('SELECT <% secrets.forEach((c, i) => { %><% if (i) { %>, <% } %><%= c.column %> AS <%= c.field %><% }) %> FROM <%= T %> WHERE id = ?', [id]))[0] as Record<string, string>
    const hidden = (row: object) => {
<%_ for (const c of secrets) { _%>
      expect(row).not.toHaveProperty('<%= c.field %>')
      expect(row).not.toHaveProperty('<%= c.secret.body %>')
<%_ } _%>
    }
    hidden(posted)
    hidden((await call('admin', 'get', `/${id}`).expect(200)).body.data)
    hidden(find(await list(), id)!)
    const before = await stored()
<%_ for (const c of secrets) { _%>
    expect(box.decrypt(before.<%= c.field %>)).toBe(first.<%= c.secret.body %>)
<%_ } _%>
    await call('admin', 'put', `/${id}`, {}).expect(200)
