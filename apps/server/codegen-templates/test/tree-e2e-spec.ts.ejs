    expect(zh.body.code).toBe(Err.VALIDATION_FAILED.code)
    expect(zh.body.errors.map((e: { path: string }) => e.path)).toEqual(
      FORM.filter((f) => f === '<%= P %>' || f === '<%= bad.field %>'),
    )
    const en = await create(invalid).set('Accept-Language', 'en-US').expect(400)
    expect(en.body.errors).toContainEqual({ path: '<%= bad.field %>', msg: required('en-US', '<%= bad.field %>') })
<%_ } else { _%>
    const zh = await create(body(unique(), { <%= P %>: -1 })).expect(400)
    expect(zh.body.code).toBe(Err.VALIDATION_FAILED.code)
    expect(zh.body.errors.map((e: { path: string }) => e.path)).toEqual(['<%= P %>'])
<%_ } _%>
<%_ if (toggle) { _%>
    const { id } = await add(0)
    await call('admin', 'get').query({ <%= m.enabled.field %>: 'maybe' }).expect(400)
    await call('admin', 'put', `/${id}/enabled`, { enabled: 'no' }).expect(400)
<%_ } _%>
    await call('admin', 'get', '/abc').expect(400)
  })

  it('404: unknown ids for get, update<% if (toggle) { %>, enabled<% } %>, delete', async () => {
    for (const res of [
      await call('admin', 'get', `/${MISSING}`),
      await call('admin', 'put', `/${MISSING}`, {}),
<%_ if (toggle) { _%>
      await call('admin', 'put', `/${MISSING}/enabled`, { enabled: true }),
<%_ } _%>
      await call('admin', 'delete', `/${MISSING}`),
    ])
      expectErr(res, 404, Err.NOT_FOUND.code)
  })

  it('the same create submitted twice within 3 s → 429 (@Idempotent)', async () => {
    const tag = unique()
    await create(body(tag)).expect(201)
    expectErr(await create(body(tag)), 429, Err.TOO_MANY_REQUESTS.code)
  })
})

it('@ActionLog: every write leaves a row with domain <%= m.key %>, its verb and the id', async () => {
  const trace = `${PREFIX}${process.pid}-`
  const created = await create(body(unique())).set('X-Request-Id', `${trace}c`).expect(201)
  const { id } = created.body.data
  await call('admin', 'put', `/${id}`, {}).set('X-Request-Id', `${trace}u`)
<%_ if (toggle) { _%>
  await call('admin', 'put', `/${id}/enabled`, { enabled: false }).set('X-Request-Id', `${trace}e`)
<%_ } _%>
  await call('admin', 'delete', `/${id}`).set('X-Request-Id', `${trace}d`)
  await call('admin', 'delete', `/${MISSING}`).set('X-Request-Id', `${trace}m`)
  const expected: [string, object][] = [
    ['c', { verb: 'create', biz_id: String(id), ok: 1 }],
    ['u', { verb: 'modify', biz_id: String(id), ok: 1 }],
<%_ if (toggle) { _%>
    ['e', { verb: 'modify', biz_id: String(id), ok: 1 }],
<%_ } _%>
    ['d', { verb: 'remove', biz_id: String(id), ok: 1 }],
    ['m', { verb: 'remove', biz_id: String(MISSING), ok: 0, error_msg: Err.NOT_FOUND.key }],
  ]
  for (const [suffix, row] of expected)
    expect(await logOf(ds, `${trace}${suffix}`)).toMatchObject({
      domain: '<%= m.key %>',
      username: 'admin',
      ...row,
    })
})

