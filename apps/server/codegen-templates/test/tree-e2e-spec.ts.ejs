<%_ if (key || toggle) { _%>

  it('list filters<% if (key) { %>: text contains (LIKE wildcards literal)<% } %><% if (toggle) { %><% if (key) { %>,<% } else { %>:<% } %> enabled equals<% } %>; a match whose parent does not match is a root', async () => {
  <%_ if (key) { _%>
    const tag = unique()
