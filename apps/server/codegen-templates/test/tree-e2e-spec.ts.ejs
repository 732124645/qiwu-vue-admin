    // `%` and `_` in the filter are plain characters
    expect((await list({ <%= key.field %>: `${tag}_` })).map((n) => n.<%= key.field %>)).toEqual([`${tag}_x`])
  <%_ } _%>
  <%_ if (toggle) { _%>
    const on = await add(0)
