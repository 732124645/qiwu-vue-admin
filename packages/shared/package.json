{
  "name": "@qiwu/shared",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/validation/testing.ts",
      "types": "./dist/validation/testing.d.ts",
      "default": "./dist/validation/testing.js"
    },
    "./im-client": {
      "source": "./src/im-client.ts",
      "types": "./dist/im-client.d.ts",
      "default": "./dist/im-client.js"
    },
    "./im-media": {
      "source": "./src/im-media.ts",
      "types": "./dist/im-media.d.ts",
      "default": "./dist/im-media.js"
    },
    "./i18n/*": "./src/i18n/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput --noEmitOnError",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@stablelib/utf8": "2.1.0",
    "livekit-client": "2.23.0",
    "recorder-core": "1.3.26070800",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
